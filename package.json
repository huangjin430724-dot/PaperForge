{
  "name": "PaperForge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm --workspace apps/backend run dev\" \"npm --workspace apps/frontend run dev\"",
    "dev:backend": "npm --workspace apps/backend run dev",
    "dev:frontend": "npm --workspace apps/frontend run dev",
    "start": "node apps/backend/src/index.js",
    "build": "npm --workspace apps/frontend run build",
    "preview": "npm --workspace apps/frontend run preview",
    "typecheck": "npm --workspace apps/frontend run typecheck",
    "lint": "eslint .",
    "test": "npm --workspaces --if-present run test",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "seed:demo": "node scripts/seed-demo-project.mjs",
    "backup:data": "node scripts/backup-data.mjs create",
    "restore:data": "node scripts/backup-data.mjs restore",
    "release:bundle": "node scripts/release-bundle.mjs create",
    "release:verify": "node scripts/release-bundle.mjs verify",
    "release:notes": "node scripts/release-notes.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "doctor": "node scripts/doctor.mjs",
    "env:check": "node scripts/env-check.mjs",
    "diagnostics": "node scripts/diagnostics.mjs",
    "diagnostics:check": "node scripts/validate-diagnostics.mjs",
    "docs:check": "node scripts/check-doc-links.mjs",
    "maturity:check": "node scripts/maturity-check.mjs",
    "deps:check": "node scripts/dependency-check.mjs",
    "status:report": "node scripts/status-report.mjs",
    "check:figures": "node scripts/check-figure-assets.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run check:figures && npm run docs:check && npm run env:check && npm run deps:check && npm run diagnostics:check && npm run maturity:check && npm run status:report -- --out-dir .tmp/status-report-check && npm run release:notes -- --out-dir .tmp/release-notes-check && npm run security:scan && npm run build",
    "tunnel": "npm run build && cross-env PaperForge_TUNNEL=localtunnel node apps/backend/src/index.js",
    "tunnel:cf": "npm run build && cross-env PaperForge_TUNNEL=cloudflared node apps/backend/src/index.js",
    "tunnel:ngrok": "npm run build && cross-env PaperForge_TUNNEL=ngrok node apps/backend/src/index.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript-eslint": "^8.59.4"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "tar": "^6.2.1"
  }
}

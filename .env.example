# PaperForge environment template
# Copy this file to .env and fill in values for your deployment.

# Server
PORT=8787
PaperForge_DATA_DIR=./data

# Main OpenAI-compatible LLM
PaperForge_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
PaperForge_LLM_API_KEY=
PaperForge_LLM_MODEL=gpt-4o-mini

# Thinking mode for compatible models
# Values:
#   PaperForge_LLM_THINKING=true|false
#   PaperForge_LLM_THINKING_MODE=auto|on|off
PaperForge_LLM_THINKING=false
PaperForge_LLM_THINKING_MODE=auto

# MinerU PDF-to-Markdown-to-LaTeX transfer
PaperForge_MINERU_API_BASE=https://mineru.net/api/v4
PaperForge_MINERU_TOKEN=

# Collaboration security
# Set a strong random value before exposing PaperForge outside localhost.
PaperForge_COLLAB_TOKEN_SECRET=change-me-to-a-long-random-secret
PaperForge_COLLAB_REQUIRE_TOKEN=true
PaperForge_COLLAB_TOKEN_TTL=86400
PaperForge_COLLAB_FLUSH_DEBOUNCE_MS=800

# Optional public tunnel mode: false | localtunnel | cloudflared | ngrok
PaperForge_TUNNEL=false

# Optional ngrok token when PaperForge_TUNNEL=ngrok
NGROK_AUTHTOKEN=

# Optional Python executable for table/chart generation
PaperForge_PYTHON=
